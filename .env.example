# ============================================================
# urk — Environment Variables Template
# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing real secrets.
# ============================================================

# --- Application / Auth.js --------------------------------------
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-32-chars-min
AUTH_REDIRECT_PROXY_URL=https://www.urklist.com/api/auth

# --- MongoDB (use urklist_dev for local development) -----------
# Production:   mongodb+srv://user:pass@ProdUrklistCluster.xxxxx.mongodb.net/urklist
# Preview:      ...same cluster.../urklist_preview
# Development:  ...same cluster.../urklist_dev
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urklist_dev?retryWrites=true&w=majority
DATABASE_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/urklist_dev?retryWrites=true&w=majority

# --- GitHub OAuth -----------------------------------------------
GITHUB_ID=your-github-oauth-app-client-id
GITHUB_SECRET=your-github-oauth-app-client-secret

# --- Google OAuth -----------------------------------------------
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Email (NextAuth email provider) ----------------------------
EMAIL=your-inbox@example.com

# --- Cloudinary -------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# --- Backblaze B2 -----------------------------------------------
NEXT_PUBLIC_BACKBLAZE_BUCKET_URL=https://your-bucket.s3.us-west-004.backblazeb2.com

# --- Google Analytics -------------------------------------------
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Brand Agent (Railway service) ------------------------------
BRAND_AGENT_URL=https://your-brand-agent.up.railway.app
BRAND_AGENT_API_KEY=your-brand-agent-api-key

# --- Statsig Experimentation ------------------------------------
experimentation_STATSIG_SERVER_API_KEY=server-xxxxxxxxxxxxxxxxxxxx
experimentation_STATSIG_CLIENT_KEY=client-xxxxxxxxxxxxxxxxxxxx
experimentation_EXPERIMENTATION_CONFIG_ITEM_KEY=your-config-item-key

# --- Legacy Data API (MongoDB Atlas Data API) -------------------
DATA_API_KEY=your-atlas-data-api-key
DATA_API_URL=https://data.mongodb-api.com/app/<app-id>/endpoint/data/v1

# ============================================================
# GitHub Actions Secrets (set in repo Settings > Secrets):
#   MONGODB_URI_PROD     — full URI pointing to urklist      (production)
#   MONGODB_URI_PREVIEW  — full URI pointing to urklist_preview
#   MONGODB_URI_DEV      — full URI pointing to urklist_dev
# ============================================================
